# Applied only by sticky-voice-classifier-test.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.voice.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.voice.csv"

# Smallest ESP-SR 2.4.x Chinese runtime-command model available for ESP32-S3.
CONFIG_SR_MN_CN_NONE=n
CONFIG_SR_MN_CN_MULTINET5_RECOGNITION_QUANT8=y
